<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site "aiesi2027.uneti.edu.vn" — reverse proxy in front of the Next.js
  standalone server (node server.js) listening on 127.0.0.1:3100.

  Requires on the server: URL Rewrite 2.1 + Application Request Routing 3.0,
  and the apphost settings listed in deploy/iis/README.md (proxy enabled,
  HTTP_X_FORWARDED_PROTO / HTTP_X_FORWARDED_HOST allowed).
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- Paper uploads: up to 5 manuscripts per submission (200 MB). -->
        <requestLimits maxAllowedContentLength="209715200" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <rewrite>
      <rules>
        <rule name="Redirect HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect"
                  url="https://aiesi2027.uneti.edu.vn/{R:1}"
                  redirectType="Permanent" />
        </rule>

        <rule name="Proxy to Next.js standalone" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3100/{R:1}" />
          <serverVariables>
            <!-- shouldUseSecureCookie() reads x-forwarded-proto to set the
                 Secure flag on icai_auth_session. -->
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="aiesi2027.uneti.edu.vn" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
