# `output: "standalone"` copies node_modules as-is. pnpm's default symlinked
# layout only resolves through its .pnpm real paths, so a payload copied or
# zipped to another machine (deploy/iis) loses @swc/helpers and friends and the
# server dies with MODULE_NOT_FOUND. A hoisted (npm-like) layout makes the
# standalone output self-contained.
node-linker=hoisted
